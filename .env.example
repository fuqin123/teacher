# ============================================================================
# 访问方式一：校内 IP / 本机 HTTP 测试（无域名时使用，默认）
#   - 浏览器访问 http://<服务器IP>:<HTTP_PORT>
#   - SITE_ADDRESS 必须是 ":80"（容器内 Caddy 监听 80，再由 HTTP_PORT 映射到宿主机）
#   - 写成域名会让 Caddy 申请证书并强制跳转 HTTPS，用 IP+端口访问就会提示“不安全/无法建立安全连接”
#   - HTTP 下必须 COOKIE_SECURE=false，否则浏览器不会保存登录 Cookie
# ============================================================================
HTTP_PORT="8083"
# 纯 HTTP 模式下 443 不会使用，但 compose 仍会绑定它，必须填一个空闲端口
HTTPS_PORT="8443"
SITE_ADDRESS=":80"
APP_ORIGIN="http://10.113.1.238:8083"
COOKIE_SECURE="false"
# 仅在「HTTPS + 裸 IP」时使用：客户端访问 IP 不带 SNI，需指定默认证书名（与 SITE_ADDRESS 的 IP 一致）
# TLS_DEFAULT_SNI="10.113.1.238"

# ============================================================================
# 访问方式二：域名 + HTTPS 正式部署（启用时注释掉上面四项）
#   - 域名需解析到服务器，80/443 对公网开放，Caddy 自动申请证书
# ============================================================================
# HTTP_PORT="80"
# HTTPS_PORT="443"
# SITE_ADDRESS="scorelens.example.com"
# APP_ORIGIN="https://scorelens.example.com"
# COOKIE_SECURE="true"

SESSION_SECRET="replace-with-openssl-rand-hex-32"

# AI 表头识别（OpenAI 兼容接口）；不需要时保持 AI_ENABLED=false
AI_ENABLED="false"
AI_BASE_URL="https://api.deepseek.com/v1"
AI_API_KEY=""
AI_MODEL="deepseek-chat"
AI_TIMEOUT_MS="25000"
