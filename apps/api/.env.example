NODE_ENV="development"
# SQLite 数据库文件；相对路径以 apps/api/prisma/schema.prisma 所在目录为基准，即落盘到 apps/api/data/scorelens.db
DATABASE_URL="file:../data/scorelens.db"
SESSION_SECRET="change-me-to-a-long-random-string"
APP_ORIGIN="http://localhost:5173"
COOKIE_SECURE="false"
PORT=3100
UPLOAD_DIR="./data/uploads"
TZ="Asia/Shanghai"

# ---- AI 表头识别（OpenAI 兼容接口；AI_ENABLED=false 或 AI_API_KEY 为空时不启用） ----
AI_ENABLED="false"
AI_BASE_URL="https://api.deepseek.com/v1"
AI_API_KEY=""
AI_MODEL="deepseek-chat"
AI_TIMEOUT_MS=25000
